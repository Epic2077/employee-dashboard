# Supabase (hosted or self-hosted)
NEXT_PUBLIC_SUPABASE_URL=
# New-style publishable key. If your self-hosted instance only exposes the
# legacy anon key, use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used for employee provisioning and username -> email lookup.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Domain used to build internal login emails (emp-<employee_code>@domain).
EMPLOYEE_EMAIL_DOMAIN=staff.local
